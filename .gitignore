# ============================================================
# .gitignore for GLOM-Hamiltonian MATLAB repository
# ============================================================

# ── MATLAB generated files ────────────────────────────────────────────

# Compiled MEX binaries (platform-specific)
*.mex*
*.mexa64
*.mexmaci64
*.mexw64

# MATLAB figure files
*.fig

# MATLAB data files (large; share selectively via separate data repo or Zenodo)
*.mat

# Simulink files (not used here but common in MATLAB repos)
*.slx
*.slxc
*.mdl
*.mldatx

# MATLAB app files
*.mlapp
*.mlappinstall

# MATLAB project files
*.prj

# Autosaved session and workspace files
*.asv
matlab.prf

# MATLAB toolbox files
*.mltbx

# Code analysis and coverage reports
*.mlcoverage

# Profiler output
*.mlprofresult

# MATLAB cache and build artifacts
.matlab/
codegen/
derived/
slprj/

# ── Editor and OS artifacts ───────────────────────────────────────────

# macOS metadata
.DS_Store
.AppleDouble
.LSOverrides
__MACOSX/

# Windows thumbnails and metadata
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Linux temporary files
*~
.fuse_hidden*
.directory
.Trash-*

# ── Editor temporary files ────────────────────────────────────────────

# Vim swap files
*.swp
*.swo
*.swn
.netrwhist

# Emacs backup files
\#*\#
.\#*

# VS Code settings
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-workspace

# Sublime Text project files
*.sublime-project
*.sublime-workspace

# ── Output files that should not be committed ────────────────────────

# PDF exports from MATLAB (generated by print() calls in scripts)
*.pdf

# Log files from MATLAB batch runs
*.log

# CSV or text output dumps
output/
results/
*.out

# ── Version control artifacts ─────────────────────────────────────────

# Patch files
*.orig
*.rej
*.patch